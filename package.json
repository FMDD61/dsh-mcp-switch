{
  "name": "dsh-mcp-switch",
  "version": "0.7.2",
  "description": "Per-session MCP server switching with a constant tool surface for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "AGENTS.md",
    "docs/design.md",
    "docs/measurements.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FMDD61/dsh-mcp-switch.git"
  },
  "bugs": {
    "url": "https://github.com/FMDD61/dsh-mcp-switch/issues"
  },
  "homepage": "https://github.com/FMDD61/dsh-mcp-switch#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.1 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.1 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1 <0.3.0 || >=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
